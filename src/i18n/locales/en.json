  "capabilities": {
    "section": "RENDERING CAPABILITIES",
    "title": "Cinematic Rendering Pipeline",
    "subtitle": "Physical-based HDR pipeline surpassing soup3D — mip-chain bloom, atmospheric scattering, morphological AA and more.",
    "vsSoup3D": "VS soup3D",
    "advantageLabel": "ADV:",
    "items": {
      "bloom": {
        "title": "UnrealBloom",
        "desc": "5-level mip Gaussian bloom with soft-knee threshold and lens dirt.",
        "advantage": "soup3D has single box blur"
      },
      "sky": {
        "title": "SkyAtmosphere",
        "desc": "GPU ray-marched Rayleigh + Mie + Ozone multi-scatter sky.",
        "advantage": "soup3D has flat sky color"
      },
      "smaa": {
        "title": "SMAA",
        "desc": "Subpixel Morphological Antialiasing with procedural LUTs.",
        "advantage": "soup3D has FXAA only"
      },
      "gtao": {
        "title": "GTAO",
        "desc": "Ground Truth ambient occlusion via hemisphere horizon integration.",
        "advantage": "soup3D has no AO"
      },
      "sss": {
        "title": "SSSS",
        "desc": "Screen-space subsurface scattering for skin translucency.",
        "advantage": "soup3D has no SSS"
      },
      "taa": {
        "title": "TAA",
        "desc": "Temporal antialiasing with Halton jitter and history clipping.",
        "advantage": "soup3D has no TAA"
      },
      "ssr": {
        "title": "SSR",
        "desc": "Screen-space reflections with roughness-modulated blur.",
        "advantage": "soup3D has no SSR"
      },
      "sssr": {
        "title": "Stochastic SSR",
        "desc": "GGX importance-sampled screen-space reflections with temporal accumulation for physically correct rough reflections.",
        "advantage": "soup3D has no SSR"
      },
      "volfog": {
        "title": "Volumetric Fog",
        "desc": "Ray-marched volumetric fog with god rays and scattering.",
        "advantage": "soup3D has no volfog"
      },
      "volcloud": {
        "title": "Volumetric Clouds",
        "desc": "GPU ray-marched volumetric clouds with 3D Perlin+Worley noise, Beer-Powder transmittance, dual-lobed HG phase (silver-lining), and multi-scattering.",
        "advantage": "soup3D has no volumetric clouds"
      },
      "caustics": {
        "title": "Underwater Caustics",
        "desc": "Screen-space underwater caustics with depth reconstruction, three-wave procedural pattern, RGB chromatic dispersion, and Beer-Lambert depth attenuation.",
        "advantage": "soup3D has no water rendering"
      },
      "waterSurface": {
        "title": "Water Surface",
        "desc": "Screen-space planar water with 4-directional Gerstner waves, Schlick Fresnel reflection/refraction blend, Beer-Lambert depth absorption, and Blinn-Phong sun specular.",
        "advantage": "soup3D has no water rendering"
      },
      "godRays": {
        "title": "God Rays",
        "desc": "Screen-space volumetric light shafts (crepuscular rays) with radial sampling, luminance-threshold extraction, exponential decay, and depth-aware occlusion — ~10x cheaper than VolumetricFog.",
        "advantage": "soup3D has no atmospheric scattering"
      },
      "lensFlare": {
        "title": "Lens Flare",
        "desc": "Screen-space lens flare with ghost chain, RGB chromatic aberration, gaussian halo ring, and starburst rays — depth-occluded, off-screen faded, ~5x cheaper than GodRays.",
        "advantage": "soup3D has no lens flare"
      },
      "gpuParticles": {
        "title": "GPU Particles",
        "desc": "GPU particle system with RGBA32F texture ping-pong simulation, MRT single-pass integrate, POINTS + gl_VertexID fetch rendering — 65536+ particles, zero CPU readback.",
        "advantage": "soup3D has no particle system"
      },
      "heightFog": {
        "title": "Height Fog",
        "desc": "UE5-style exponential height fog with closed-form Beer-Lambert density and sun inscattering.",
        "advantage": "soup3D has no fog"
      },
      "ssgi": {
        "title": "SSGI",
        "desc": "Screen-space global illumination with 8-ray cosine hemisphere sampling.",
        "advantage": "soup3D has no GI"
      },
      "ddgi": {
        "title": "DDGI",
        "desc": "Dynamic diffuse global illumination with 3D irradiance probe grid, SH2 directional storage, and real-time relighting.",
        "advantage": "soup3D has no GI"
      },
      "pcss": {
        "title": "PCSS",
        "desc": "Percentage-closer soft shadows with blocker search and penumbra estimation.",
        "advantage": "soup3D has hard shadows only"
      },
      "lut": {
        "title": "LUT Grading",
        "desc": "3D/2D strip LUT color grading with .cube file support.",
        "advantage": "soup3D has no color grading"
      },
      "decal": {
        "title": "Decals",
        "desc": "Projected decal system with lifetime, fading, and normal alignment.",
        "advantage": "soup3D has no decals"
      },
      "skin": {
        "title": "Skin SSS",
        "desc": "Pre-integrated skin BSSRDF with d'Eon 2007 diffuse/transmittance LUTs.",
        "advantage": "soup3D has no skin shader"
      },
      "sharpen": {
        "title": "CAS Sharpen",
        "desc": "AMD FidelityFX contrast-adaptive sharpening. Restores TAA-softened detail.",
        "advantage": "soup3D has no sharpening"
      },
      "fsr": {
        "title": "FSR Upscale",
        "desc": "FidelityFX FSR1 edge-adaptive spatial upscaling. Render at 50-70% resolution.",
        "advantage": "soup3D has no upscaling"
      },
      "specularAA": {
        "title": "Specular AA",
        "desc": "Toksvig/LEAN filtering. Eliminates specular shimmer on bumpy normals at distance.",
        "advantage": "soup3D has no PBR"
      }
    }
